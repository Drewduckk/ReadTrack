<div class="card shadow-sm mt-4">
  <div class="card-header bg-light d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Activity Log & Feed</h5>
    <span class="badge bg-secondary"><%= @recent_activities&.count || 0 %> entries</span>
  </div>
  <div class="card-body p-0">
    <% if @recent_activities.present? %>
      <div class="list-group list-group-flush">
        <% @recent_activities.each do |version| %>
          <% user = User.find_by(id: version.whodunnit) %>
          <div class="list-group-item d-flex justify-content-between align-items-center py-2">
            <div>
              <span class="badge <%= version.event == 'create' ? 'bg-success' : (version.event == 'update' ? 'bg-primary' : 'bg-danger') %> me-2">
                <%= version.event.upcase %>
              </span>
              <strong><%= user ? "#{user.name} (#{user.role})" : "User ##{version.whodunnit || '?'}" %>:</strong>

              <% case version.item_type %>
              <% when "ReadingAssignment" %>
                <% if version.event == "create" %>
                  Created new reading assignment (assignment #<%= version.item_id %>)
                <% elsif version.event == "update" && version.changeset["released_until"].present? %>
                  Released range changed: page <%= version.changeset["released_until"][0] %> &rarr; <strong>page <%= version.changeset["released_until"][1] %></strong>
                <% else %>
                  Reading assignment #<%= version.item_id %> updated
                <% end %>

              <% when "Summary" %>
                <% if version.event == "create" %>
                  Created summary for
                  <% if version.changeset["page_from"] && version.changeset["page_to"] %>
                    pages <%= version.changeset["page_from"][1] %>–<%= version.changeset["page_to"][1] %>
                  <% else %>
                    section (entry #<%= version.item_id %>)
                  <% end %>
                <% else %>
                  Summary #<%= version.item_id %> updated
                <% end %>

              <% when "ReadingProgress" %>
                Reading progress updated to
                <% if version.changeset["current_page"].present? %>
                  <strong>page <%= version.changeset["current_page"][1] %></strong>
                <% else %>
                  a new position
                <% end %>

              <% when "Book" %>
                Book <%= version.event == "create" ? "created" : "edited" %>:
                <%= version.changeset["title"]&.last || "Book ##{version.item_id}" %>

              <% else %>
                <%= version.item_type %> #<%= version.item_id %> (<%= version.event %>)
              <% end %>
            </div>
            <small class="text-muted"><%= time_ago_in_words(version.created_at) %> ago</small>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-3 text-muted">No activity recorded yet.</div>
    <% end %>
  </div>
</div>
