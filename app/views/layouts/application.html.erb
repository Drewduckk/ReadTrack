<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "ReadTrack" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="application-name" content="ReadTrack">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %><%= csp_meta_tag %><%= yield :head %>
  <link rel="icon" href="/icon.png" type="image/png"><link rel="icon" href="/icon.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="/icon.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %><%= javascript_importmap_tags %>
</head>
<body>
<header class="rt-navbar"><nav class="container rt-navbar-inner d-flex align-items-center justify-content-between">
  <%= link_to "ReadTrack", current_user ? dashboard_path : root_path, class: "rt-brand" %>
  <div class="d-flex align-items-center gap-3">
    <% if current_user %>
      <%= link_to "Dashboard", dashboard_path, class: "rt-nav-link" %>
      <%= link_to "Books", books_path, class: "rt-nav-link" %>
      <%= link_to "Reading Assignments", reading_assignments_path, class: "rt-nav-link" %>
      <%= link_to "Profile", profile_path, class: "rt-nav-link" %>
      <% if current_user.admin? %><%= link_to "Users", admin_users_path, class: "rt-nav-link" %><% end %>
      <%= button_to "Log out", session_path, method: :delete, class: "btn btn-sm btn-outline-secondary" %>
    <% else %>
      <%= link_to "Sign in", new_session_path, class: "rt-nav-link" %>
      <%= link_to "Create account", signup_path, class: "btn btn-sm btn-primary" %>
    <% end %>
  </div>
</nav></header>
<main class="container rt-main">
  <% flash.each do |type,message| %><div class="rt-alert <%= type == "alert" ? "rt-alert-danger" : "rt-alert-success" %> px-3 py-2" role="alert"><%= message %></div><% end %>
  <%= yield %>
</main>
</body></html>
