<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Zusammenfassungen</h2>
</div>

<div class="row g-4">
  <% @summaries.each do |summary| %>
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title"><%= summary.reading_assignment.book.title %></h5>
            <span class="badge bg-secondary">Seiten <%= summary.page_from %>–<%= summary.page_to %></span>
          </div>
          <h6 class="card-subtitle text-muted mb-2">Schüler/in: <%= summary.student.name %></h6>
          <p class="card-text text-muted small"><%= truncate(summary.content, length: 150) %></p>
          <div class="d-flex gap-2 mt-3">
            <%= link_to "Anzeigen", summary_path(summary), class: "btn btn-sm btn-outline-primary" %>
            <% if policy(summary).edit? %>
              <%= link_to "Bearbeiten", edit_summary_path(summary), class: "btn btn-sm btn-outline-secondary" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
