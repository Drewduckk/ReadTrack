<%= form_with(model: [reading_assignment, summary].compact, class: "needs-validation") do |f| %>
  <% if summary.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h6 class="alert-heading fw-bold"><%= pluralize(summary.errors.count, "error") %> prevented this summary from being saved:</h6>
      <ul class="mb-0">
        <% summary.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% assignment = reading_assignment || summary.reading_assignment %>
  <% if assignment %>
    <div class="alert alert-info">
      <strong>Release note:</strong> The teacher has released the reading material <strong>up to page <%= assignment.released_until %></strong>. Summaries may not go beyond this range.
    </div>
  <% end %>

  <div class="row mb-3">
    <div class="col-md-6">
      <%= f.label :page_from, "Page from", class: "form-label" %>
      <%= f.number_field :page_from, min: 1, max: assignment&.released_until, class: "form-control", required: true %>
    </div>
    <div class="col-md-6">
      <%= f.label :page_to, "Page to", class: "form-label" %>
      <%= f.number_field :page_to, min: 1, max: assignment&.released_until, class: "form-control", required: true %>
      <div class="form-text">Maximum page <%= assignment&.released_until %>.</div>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :content, "Your summary", class: "form-label" %>
    <%= f.text_area :content, rows: 8, class: "form-control", required: true, placeholder: "Summarize the content of the section you read, in your own words..." %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit "Save summary", class: "btn btn-primary" %>
    <% cancel_path = assignment ? reading_assignment_path(assignment) : dashboard_path %>
    <%= link_to "Cancel", cancel_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
