<div class="rt-page-narrow"><div class="rt-page-header"><h1>Edit profile</h1><p>Update the information shown on your account.</p></div><div class="rt-card"><div class="rt-card-body"><% if @user.errors.any? %><div class="rt-errors"><p><%= pluralize(@user.errors.count,"error") %> prevented saving.</p><ul><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %><%= form_with model:@user,url:profile_path do |form| %><div class="rt-form-group"><%= form.label :name,class:"form-label" %><%= form.text_field :name,class:"form-control",autocomplete:"name",autofocus:true %></div><div class="rt-form-actions"><%= form.submit "Save changes",class:"btn btn-primary" %><%= link_to "Cancel",profile_path,class:"btn btn-outline-secondary" %></div><% end %></div></div></div>
