<div class="rt-page-narrow"><div class="rt-page-header"><h1>Change password</h1><p>For security, enter your current password before choosing a new one.</p></div><div class="rt-card"><div class="rt-card-body"><% if @user.errors.any? %><div class="rt-errors"><p>Please check the following:</p><ul><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %><%= form_with url:profile_password_path,method: :patch do |form| %><div class="rt-form-group"><%= form.label :current_password,"Current password",class:"form-label" %><%= form.password_field :current_password,class:"form-control",autocomplete:"current-password",autofocus:true %></div><div class="rt-form-group"><%= form.label :password,"New password",class:"form-label" %><%= form.password_field :password,class:"form-control",autocomplete:"new-password" %><div class="rt-help">Use at least 12 characters.</div></div><div class="rt-form-group"><%= form.label :password_confirmation,"Confirm new password",class:"form-label" %><%= form.password_field :password_confirmation,class:"form-control",autocomplete:"new-password" %></div><div class="rt-form-actions"><%= form.submit "Change password",class:"btn btn-primary" %><%= link_to "Cancel",profile_path,class:"btn btn-outline-secondary" %></div><% end %></div></div></div>
