<div class="rt-page-narrow"><div class="rt-page-header"><h1>Change email</h1><p>Your current email stays active until the new address is confirmed.</p></div><div class="rt-card"><div class="rt-card-body"><%= form_with url:profile_email_path,method: :patch do |form| %><div class="rt-form-group"><%= form.label :email_address,"New email address",class:"form-label" %><%= form.email_field :email_address,class:"form-control",autocomplete:"email",autofocus:true %></div><div class="rt-form-actions"><%= form.submit "Send confirmation link",class:"btn btn-primary" %><%= link_to "Cancel",profile_path,class:"btn btn-outline-secondary" %></div><% end %></div></div></div>
