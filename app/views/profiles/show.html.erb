<div class="rt-page"><div class="rt-page-header"><h1>My profile</h1><p>Manage your account information and security settings.</p></div><div class="rt-card"><div class="rt-card-body"><dl class="rt-profile-list"><div class="rt-profile-row"><dt class="rt-profile-label">Name</dt><dd class="rt-profile-value"><%= @user.name %></dd></div><div class="rt-profile-row"><dt class="rt-profile-label">Email</dt><dd class="rt-profile-value"><%= @user.email_address %><% if @user.email_change.present? %><div class="rt-help">Confirmation pending for <%= @user.email_change %>.</div><% end %></dd></div><div class="rt-profile-row"><dt class="rt-profile-label">Role</dt><dd class="rt-profile-value"><span class="rt-role"><%= @user.role %></span></dd></div></dl><div class="rt-profile-actions"><%= link_to "Edit profile",edit_profile_path,class:"btn btn-primary" %><%= link_to "Change password",edit_profile_password_path,class:"btn btn-outline-secondary" %><%= link_to "Change email",edit_profile_email_path,class:"btn btn-outline-secondary" %></div></div></div></div>
