<div class="rt-page-narrow"><div class="rt-page-header text-center"><h1>Sign in</h1><p>Sign in to your ReadTrack account.</p></div><div class="rt-card"><div class="rt-card-body"><%= form_with url: session_path do |form| %><div class="rt-form-group"><%= form.label :email_address,"Email address",class:"form-label" %><%= form.email_field :email_address,class:"form-control",autocomplete:"email",autofocus:true %></div><div class="rt-form-group"><%= form.label :password,class:"form-label" %><%= form.password_field :password,class:"form-control",autocomplete:"current-password" %></div><div class="d-grid"><%= form.submit "Sign in",class:"btn btn-primary" %></div><% end %><p class="rt-auth-footer mb-0">Don't have an account? <%= link_to "Create one",signup_path %></p></div></div></div>
