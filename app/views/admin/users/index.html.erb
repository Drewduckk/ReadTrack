<div class="rt-page"><div class="rt-page-header"><h1>User administration</h1><p>View registered users and manage their account details and roles.</p></div><div class="rt-card"><div class="rt-table-wrap"><table class="table table-hover rt-table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Action</th></tr></thead><tbody><% @users.each do |user| %><tr><td class="fw-semibold"><%= user.name %></td><td><%= user.email_address %></td><td><span class="rt-role"><%= user.role %></span></td><td><%= link_to "Edit",edit_admin_user_path(user),class:"btn btn-sm btn-outline-secondary" %></td></tr><% end %></tbody></table></div></div></div>
