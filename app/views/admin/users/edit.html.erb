<div class="rt-page-narrow"><div class="rt-page-header"><h1>Edit user</h1><p>Update the account details and role for <strong><%= @user.name %></strong>.</p></div><div class="rt-card"><div class="rt-card-body"><% if @user.errors.any? %><div class="rt-errors"><p><%= pluralize(@user.errors.count,"error") %> prevented saving.</p><ul><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %><%= form_with model:@user,url:admin_user_path(@user) do |form| %><div class="rt-form-group"><%= form.label :name,class:"form-label" %><%= form.text_field :name,class:"form-control",autocomplete:"name",autofocus:true %></div><div class="rt-form-group"><%= form.label :email_address,class:"form-label" %><%= form.email_field :email_address,class:"form-control",autocomplete:"email" %></div><div class="rt-form-group"><%= form.label :role,class:"form-label" %><%= form.select :role,User.roles.keys,{},class:"form-select" %></div><div class="rt-form-actions"><%= form.submit "Save changes",class:"btn btn-primary" %><%= link_to "Cancel",admin_users_path,class:"btn btn-outline-secondary" %></div><% end %></div></div></div>
