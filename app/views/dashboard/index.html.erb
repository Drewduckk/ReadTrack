<div class="row mb-4">
  <div class="col-12">
    <div class="p-4 bg-light rounded-3 border">
      <h2>Welcome to ReadTogether, <%= current_user.name %>!</h2>
      <p class="lead mb-0">Role: <span class="badge bg-primary"><%= current_user.role.capitalize %></span></p>
    </div>
  </div>
</div>

<% if current_user.teacher? %>
  <div class="row mb-4">
    <div class="col-md-8">
      <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h4 class="mb-0">My Classes & Reading Assignments</h4>
          <%= link_to "+ New reading assignment", new_reading_assignment_path, class: "btn btn-sm btn-primary" %>
        </div>
        <div class="card-body">
          <% if @reading_assignments.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead>
                  <tr>
                    <th>Book</th>
                    <th>Released until</th>
                    <th>Summaries</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @reading_assignments.each do |assignment| %>
                    <tr>
                      <td><strong><%= assignment.book.title %></strong><br><small class="text-muted"><%= assignment.book.author %></small></td>
                      <td><span class="badge bg-info text-dark fs-6">Page <%= assignment.released_until %></span></td>
                      <td><%= assignment.summaries.count %></td>
                      <td>
                        <%= link_to "Class overview", reading_assignment_path(assignment), class: "btn btn-sm btn-outline-primary" %>
                        <%= link_to "Edit", edit_reading_assignment_path(assignment), class: "btn btn-sm btn-outline-secondary" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted mb-0">No reading assignments created yet. Click "+ New reading assignment".</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Books / Stories</h5>
          <%= link_to "+ New", new_book_path, class: "btn btn-sm btn-outline-primary" %>
        </div>
        <div class="card-body">
          <% if @books.any? %>
            <ul class="list-group list-group-flush">
              <% @books.each do |book| %>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                  <div>
                    <strong><%= book.title %></strong><br>
                    <small class="text-muted"><%= book.author %></small>
                  </div>
                  <%= link_to "View", book_path(book), class: "btn btn-sm btn-outline-secondary" %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-muted mb-0">No books yet.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

<% elsif current_user.student? %>
  <div class="row mb-4">
    <div class="col-md-8">
      <div class="card shadow-sm mb-4">
        <div class="card-header">
          <h4 class="mb-0">My Reading Assignments & Books</h4>
        </div>
        <div class="card-body">
          <% if @reading_assignments.any? %>
            <div class="row g-3">
              <% @reading_assignments.each do |assignment| %>
                <% progress = @my_progresses[assignment.id] %>
                <div class="col-12">
                  <div class="card border">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                          <h5 class="card-title mb-1"><%= assignment.book.title %></h5>
                          <h6 class="card-subtitle text-muted">Author: <%= assignment.book.author %> | Teacher: <%= assignment.teacher.name %></h6>
                        </div>
                        <span class="badge bg-success fs-6">Released up to page <%= assignment.released_until %></span>
                      </div>
                      <p class="mb-3">
                        <strong>My current reading progress:</strong>
                        <% if progress %>
                          <span class="badge bg-secondary">Page <%= progress.current_page %></span>
                        <% else %>
                          <span class="text-muted">Not started yet</span>
                        <% end %>
                      </p>
                      <div class="d-flex gap-2">
                        <%= link_to "Read online", read_reading_assignment_path(assignment), class: "btn btn-primary" %>
                        <%= link_to "Write summary", new_reading_assignment_summary_path(assignment), class: "btn btn-outline-success" %>
                        <%= link_to "Details", reading_assignment_path(assignment), class: "btn btn-outline-secondary" %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted mb-0">There are currently no reading assignments.</p>
          <% end %>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-header">
          <h5 class="mb-0">My Summaries</h5>
        </div>
        <div class="card-body">
          <% if @my_summaries.any? %>
            <div class="list-group">
              <% @my_summaries.each do |summary| %>
                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                  <div>
                    <h6><%= summary.reading_assignment.book.title %> (pages <%= summary.page_from %>–<%= summary.page_to %>)</h6>
                    <p class="text-muted mb-0 small"><%= truncate(summary.content, length: 100) %></p>
                  </div>
                  <div class="d-flex gap-2">
                    <%= link_to "View", summary_path(summary), class: "btn btn-sm btn-outline-primary" %>
                    <%= link_to "Edit", edit_summary_path(summary), class: "btn btn-sm btn-outline-secondary" %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted mb-0">You haven't written any summaries yet.</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <%= render "shared/activity_feed" %>
    </div>
  </div>

<% else %>
  <div class="row mb-4">
    <div class="col-md-8">
      <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h4 class="mb-0">Admin Overview</h4>
          <div class="d-flex gap-2">
            <%= link_to "User Administration", admin_users_path, class: "btn btn-primary btn-sm" %>
            <%= link_to "+ Book", new_book_path, class: "btn btn-outline-primary btn-sm" %>
            <%= link_to "+ Reading assignment", new_reading_assignment_path, class: "btn btn-outline-secondary btn-sm" %>
          </div>
        </div>
        <div class="card-body">
          <h5>All Reading Assignments (<%= @reading_assignments.count %>)</h5>
          <ul class="list-group list-group-flush mb-4">
            <% @reading_assignments.each do |ra| %>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><%= ra.book.title %> (Teacher: <%= ra.teacher.name %>) - Released up to page <%= ra.released_until %></span>
                <%= link_to "Open", reading_assignment_path(ra), class: "btn btn-sm btn-outline-secondary" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <%= render "shared/activity_feed" %>
    </div>
  </div>
<% end %>

<% if current_user.teacher? %>
  <div class="row">
    <div class="col-12">
      <%= render "shared/activity_feed" %>
    </div>
  </div>
<% end %>
