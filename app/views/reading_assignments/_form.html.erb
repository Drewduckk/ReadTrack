<%= form_with(model: reading_assignment, class: "needs-validation") do |f| %>
  <% if reading_assignment.errors.any? %>
    <div class="alert alert-danger">
      <h6><%= pluralize(reading_assignment.errors.count, "Fehler") %>:</h6>
      <ul class="mb-0">
        <% reading_assignment.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :book_id, "Buch / Geschichte", class: "form-label" %>
    <%= f.collection_select :book_id, Book.all, :id, :title, { prompt: "Bitte Buch auswählen..." }, class: "form-select", required: true %>
    <div class="form-text">
      Seitenzahl je Buch: <%= Book.all.map { |b| "#{b.title} (#{b.page_count} Seiten)" }.join(", ") %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :released_until, "Aktuell freigegebener Bereich (bis Seite)", class: "form-label" %>
    <%= f.number_field :released_until, min: 1, class: "form-control", required: true %>
    <div class="form-text">Schülerinnen und Schüler können den Text bis zu dieser Seite online lesen und nur für diesen Bereich Zusammenfassungen erfassen.</div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Abbrechen", reading_assignments_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
