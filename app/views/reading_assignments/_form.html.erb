<%= form_with(model: reading_assignment, class: "needs-validation") do |f| %>
  <% if reading_assignment.errors.any? %>
    <div class="alert alert-danger">
      <h6><%= pluralize(reading_assignment.errors.count, "error") %>:</h6>
      <ul class="mb-0">
        <% reading_assignment.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :book_id, "Book / Story", class: "form-label" %>
    <%= f.collection_select :book_id, Book.all, :id, :title, { prompt: "Please select a book..." }, class: "form-select", required: true %>
    <div class="form-text">
      Pages per book: <%= Book.all.map { |b| "#{b.title} (#{b.page_count} pages)" }.join(", ") %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :released_until, "Currently released range (up to page)", class: "form-label" %>
    <%= f.number_field :released_until, min: 1, class: "form-control", required: true %>
    <div class="form-text">Students can read the text online up to this page and only create summaries for this range.</div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", reading_assignments_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
