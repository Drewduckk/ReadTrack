<div class="mb-4">
  <%= link_to "&larr; Zurück zur Übersicht".html_safe, books_path, class: "text-decoration-none" %>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <div>
      <h3 class="mb-0"><%= @book.title %></h3>
      <span class="text-muted">Autor: <%= @book.author %></span>
    </div>
    <div class="d-flex gap-2">
      <% if policy(@book).edit? %>
        <%= link_to "Bearbeiten", edit_book_path(@book), class: "btn btn-outline-secondary btn-sm" %>
      <% end %>
      <% if policy(ReadingAssignment).create? %>
        <%= link_to "+ Leseauftrag erstellen", new_reading_assignment_path(book_id: @book.id), class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  </div>
  <div class="card-body">
    <h5>Inhalt:</h5>
    <div class="p-3 bg-light rounded border font-monospace" style="white-space: pre-wrap;">
      <%= @book.content %>
    </div>
  </div>
</div>
