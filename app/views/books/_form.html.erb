<%= form_with(model: book, class: "needs-validation") do |f| %>
  <% if book.errors.any? %>
    <div class="alert alert-danger">
      <h6><%= pluralize(book.errors.count, "error") %> prevented this book from being saved:</h6>
      <ul class="mb-0">
        <% book.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :title, "Book title", class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :author, "Author", class: "form-label" %>
    <%= f.text_field :author, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :content, "Content / book text", class: "form-label" %>
    <%= f.text_area :content, rows: 12, class: "form-control font-monospace", required: true, placeholder: "Enter the full text or chapter content of the book here..." %>
    <div class="form-text">Students can read this text online up to whichever range the teacher has released.</div>
  </div>

  <div class="mb-3" style="max-width: 220px;">
    <%= f.label :lines_per_page, "Lines per page", class: "form-label" %>
    <%= f.number_field :lines_per_page, min: 1, value: book.lines_per_page || 80, class: "form-control" %>
    <div class="form-text">Determines how the text is split into pages (e.g. 80 lines ≈ one screen page).</div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", books_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
