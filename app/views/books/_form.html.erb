<%= form_with(model: book, class: "needs-validation") do |f| %>
  <% if book.errors.any? %>
    <div class="alert alert-danger">
      <h6><%= pluralize(book.errors.count, "Fehler") %> verhinderten das Speichern:</h6>
      <ul class="mb-0">
        <% book.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :title, "Buchtitel", class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :author, "Autor", class: "form-label" %>
    <%= f.text_field :author, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :content, "Inhalt / Buchtext", class: "form-label" %>
    <%= f.text_area :content, rows: 12, class: "form-control font-monospace", required: true, placeholder: "Hier den vollständigen Text oder Kapitelinhalt des Buches hinterlegen..." %>
    <div class="form-text">Schüler können diesen Text online bis zum jeweils von der Lehrperson freigegebenen Bereich lesen.</div>
  </div>

  <div class="mb-3" style="max-width: 220px;">
    <%= f.label :lines_per_page, "Zeilen pro Seite", class: "form-label" %>
    <%= f.number_field :lines_per_page, min: 1, value: book.lines_per_page || 80, class: "form-control" %>
    <div class="form-text">Bestimmt, wie der Text in Seiten aufgeteilt wird (z.B. 80 Zeilen ≈ eine Bildschirmseite).</div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Abbrechen", books_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
