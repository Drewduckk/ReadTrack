<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Books & Stories</h2>
  <% if policy(Book).create? %>
    <%= link_to "+ Add new book", new_book_path, class: "btn btn-primary" %>
  <% end %>
</div>

<div class="row g-4">
  <% @books.each do |book| %>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body d-flex flex-column">
          <h5 class="card-title"><%= book.title %></h5>
          <h6 class="card-subtitle text-muted mb-2"><%= book.author %></h6>
          <p class="card-text text-muted small flex-grow-1"><%= truncate(book.content, length: 150) %></p>
          <div class="d-flex gap-2 mt-3">
            <%= link_to "View", book_path(book), class: "btn btn-sm btn-outline-primary" %>
            <% if policy(book).edit? %>
              <%= link_to "Edit", edit_book_path(book), class: "btn btn-sm btn-outline-secondary" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
